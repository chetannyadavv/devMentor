# Copy this file to .env and fill in real values.
# .env itself is git-ignored -- never commit real secrets.

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=

# Your real domain, once you have one. Used by Caddy for automatic TLS
# and by the frontend to know where the API lives.
DOMAIN=localhost
